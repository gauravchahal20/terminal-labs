# ==============================================================================
# Terminal Labs - AI Lead Generation & Qualification Platform Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Terminal Labs Lead Intelligence Platform"

# Backend & Database (Supports SQLite out-of-the-box or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./terminal_labs.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/terminal_labs

# Security & Auth (Compatible with Supabase Auth or JWT)
SECRET_KEY=terminal-labs-super-secret-production-key-change-in-prod-2025
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini API (Leave blank for offline Cognitive Demo Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
DEMO_MODE=True

# Rate Limiting & Safety
RATE_LIMIT_DELAY_SECONDS=1.0
MAX_DISCOVERY_RESULTS=50
REQUIRE_APPROVAL_BEFORE_SEND=True

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
